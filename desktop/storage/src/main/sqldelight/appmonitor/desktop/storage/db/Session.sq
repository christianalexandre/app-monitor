-- One connection of an app; `hello` is the Hello as received.
CREATE TABLE sessions (
  id INTEGER PRIMARY KEY,
  run_id INTEGER NOT NULL REFERENCES runs(id) ON DELETE CASCADE,
  device_ref INTEGER NOT NULL REFERENCES devices(id) ON DELETE CASCADE,
  app_ref INTEGER NOT NULL REFERENCES apps(id) ON DELETE CASCADE,
  server_session_id TEXT NOT NULL,
  hello BLOB NOT NULL,
  app_version TEXT NOT NULL,
  sdk_name TEXT NOT NULL,
  peer_address TEXT,
  connected_at_ms INTEGER NOT NULL,
  disconnected_at_ms INTEGER,
  last_envelope_at_ms INTEGER
);

CREATE INDEX sessions_run_id ON sessions(run_id);
CREATE INDEX sessions_last_envelope_at_ms ON sessions(last_envelope_at_ms);

insert:
INSERT INTO sessions(run_id, device_ref, app_ref, server_session_id, hello, app_version, sdk_name, peer_address, connected_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

lastId:
SELECT last_insert_rowid();

touch:
UPDATE sessions SET last_envelope_at_ms = :atMs WHERE id = :id;

disconnect:
UPDATE sessions SET disconnected_at_ms = :atMs WHERE id = :id;

closeOpen:
UPDATE sessions
SET disconnected_at_ms = coalesce(last_envelope_at_ms, connected_at_ms)
WHERE disconnected_at_ms IS NULL;

byId:
SELECT * FROM sessions WHERE id = ?;

ofRun:
SELECT sessions.*, devices.device_id, devices.name AS device_name, devices.platform, devices.os_version, apps.app_id
FROM sessions
JOIN devices ON devices.id = sessions.device_ref
JOIN apps ON apps.id = sessions.app_ref
WHERE sessions.run_id = ?
ORDER BY sessions.id;

all:
SELECT * FROM sessions ORDER BY id;

inRun:
SELECT * FROM sessions WHERE run_id = ? ORDER BY id;

-- ADR-0082 B.1, C.1: ended sessions outside named runs, oldest last envelope first. ADR-0095 B.1: `kept` when an issue
-- links one of its exchanges, then listed only while it holds something else to delete.
prunable:
SELECT sessions.id,
  EXISTS (
    SELECT 1 FROM exchanges JOIN issue_exchanges ON issue_exchanges.exchange_ref = exchanges.id
    WHERE exchanges.session_ref = sessions.id
  ) AS kept
FROM sessions
JOIN runs ON runs.id = sessions.run_id
WHERE sessions.disconnected_at_ms IS NOT NULL
  AND runs.name IS NULL
  AND coalesce(sessions.last_envelope_at_ms, sessions.connected_at_ms) < :before
  AND (
    NOT EXISTS (
      SELECT 1 FROM exchanges JOIN issue_exchanges ON issue_exchanges.exchange_ref = exchanges.id
      WHERE exchanges.session_ref = sessions.id
    )
    OR EXISTS (
      SELECT 1 FROM exchanges
      WHERE exchanges.session_ref = sessions.id
        AND NOT EXISTS (SELECT 1 FROM issue_exchanges WHERE issue_exchanges.exchange_ref = exchanges.id)
    )
    OR EXISTS (SELECT 1 FROM raw_envelopes WHERE raw_envelopes.session_ref = sessions.id)
  )
ORDER BY coalesce(sessions.last_envelope_at_ms, sessions.connected_at_ms), sessions.id
LIMIT :limit;

delete:
DELETE FROM sessions WHERE id = ?;

deleteAll:
DELETE FROM sessions;
