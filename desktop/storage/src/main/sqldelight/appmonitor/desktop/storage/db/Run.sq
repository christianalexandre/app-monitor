-- A time window on the desktop, across devices (ADR-0084); `saved` marks the one collection Save writes to (ADR-0143).
CREATE TABLE runs (
  id INTEGER PRIMARY KEY,
  name TEXT,
  started_at_ms INTEGER NOT NULL,
  ended_at_ms INTEGER,
  saved INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX runs_started_at_ms ON runs(started_at_ms);

insert:
INSERT INTO runs(started_at_ms) VALUES (?);

lastId:
SELECT last_insert_rowid();

insertSaved:
INSERT INTO runs(name, started_at_ms, ended_at_ms, saved) VALUES ('Saved', :atMs, :atMs, 1);

savedId:
SELECT id FROM runs WHERE saved = 1 LIMIT 1;

-- A run already ended keeps its end: Record after Stop, and close, end the current run again.
end:
UPDATE runs SET ended_at_ms = :endedAtMs WHERE id = :id AND ended_at_ms IS NULL;

closeOpen:
UPDATE runs
SET ended_at_ms = coalesce(
  (SELECT max(sessions.disconnected_at_ms) FROM sessions WHERE sessions.run_id = runs.id),
  runs.started_at_ms
)
WHERE ended_at_ms IS NULL;

rename:
UPDATE runs SET name = :name WHERE id = :id;

byId:
SELECT * FROM runs WHERE id = ?;

all:
SELECT * FROM runs ORDER BY id;

newestFirst:
SELECT * FROM runs ORDER BY id DESC;

pageNewestFirst:
SELECT * FROM runs WHERE id < :beforeId ORDER BY id DESC LIMIT :limit;

-- Unnamed runs left without sessions; the current run has no end, so it never matches.
deleteEmptyBefore:
DELETE FROM runs
WHERE name IS NULL
  AND saved = 0
  AND ended_at_ms < :before
  AND NOT EXISTS (SELECT 1 FROM sessions WHERE sessions.run_id = runs.id);

deleteAll:
DELETE FROM runs;
