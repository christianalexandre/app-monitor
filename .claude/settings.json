{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(./gradlew *)",
      "Bash(gradle *)",
      "Bash(java *)",
      "Bash(swift *)",
      "Bash(xcodebuild *)",
      "Bash(xcrun *)",
      "Bash(adb *)",
      "Bash(emulator *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(scripts/*)",
      "Bash(bash scripts/*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin dev*)",
      "Bash(git reset --hard origin*)",
      "Bash(gh repo delete*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)"
    ]
  }
}
